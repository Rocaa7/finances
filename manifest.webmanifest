{
  "name": "Diny",
  "short_name": "Diny",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0f766e",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv",
          "accept": [
            "text/csv",
            "text/comma-separated-values",
            "text/plain",
            "application/vnd.ms-excel",
            ".csv"
          ]
        }
      ]
    }
  }
}